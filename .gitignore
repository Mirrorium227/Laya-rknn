# Publish only the FP16 inference delivery; keep experiments and downloads local.
/*
!/.gitignore
!/README.md
!/README.en.md
!/requirements.txt

!/examples/
/examples/*
!/examples/predict_fp16.py

!/bucket-study/
/bucket-study/*
!/bucket-study/api.py
!/bucket-study/split_backend.py
!/bucket-study/split/
/bucket-study/split/*
!/bucket-study/split/l96/
!/bucket-study/split/l256/
!/bucket-study/split/l1024/
/bucket-study/split/l*/*
!/bucket-study/split/l*/manifest.json

!/rknn-probe/
/rknn-probe/*
!/rknn-probe/runtime.py

!/delivery/
/delivery/*
!/delivery/fp16/
/delivery/fp16/*
!/delivery/fp16/model_manifest.json

# Also exclude plans and generated files if more directories are allowed later.
AgentPlan*.md
AGENTS.md
__pycache__/
*.py[cod]
.venv*/
.cache/
.env
.env.*
*.rknn
*.onnx
*.safetensors
*.npy
*.npz
*.so
*.whl
*.log
ssh_known_hosts
